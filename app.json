{
  "expo": {
    "name": "OFFDAY Note",
    "slug": "offday-note",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/offday-icon.png",
    "scheme": "offdaynotes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/offday-icon.png",
      "bundleIdentifier": "com.offday.note",
      "supportsTablet": true,
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D9D9D9",
        "foregroundImage": "./assets/images/offday-foreground.png",
        "monochromeImage": "./assets/images/offday-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.offday.note",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/offday-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F6F0",
          "image": "./assets/images/offday-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#20231F",
            "image": "./assets/images/offday-splash-dark.png"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-document-picker",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
